# Required for the default example script (Groq — free tier, no card required).
# Sign up at https://console.groq.com/ to get a key.
GROQ_API_KEY=your_groq_key_here

# Optional — only needed if you re-enable the OpenAI provider.
OPENAI_API_KEY=your_openai_key_here

# Optional — only needed if you re-enable the Anthropic provider.
ANTHROPIC_API_KEY=your_anthropic_key_here
